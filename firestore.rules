rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is an admin (has entry in admins collection)
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Helper function to check if user is a super admin
    function isSuperAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    // Admins collection - stores admin user metadata and roles
    match /admins/{userId} {
      // Anyone authenticated can read to check admin status
      allow read: if isAuthenticated();
      
      // Only super admins can create new admins
      allow create: if isSuperAdmin() && 
                       request.resource.data.keys().hasAll(['email', 'role', 'createdBy', 'createdAt']) &&
                       request.resource.data.role in ['admin', 'super_admin'];
      
      // Super admins can update any admin, regular admins can update themselves
      allow update: if isSuperAdmin() || 
                       (isAdmin() && request.auth.uid == userId);
      
      // Only super admins can delete admins
      allow delete: if isSuperAdmin();
    }
    
    // Prayer Times collection
    match /prayer_times/{document=**} {
      allow read: if true; // Public read access
      allow write: if isAdmin(); // Only admins can modify
    }
    
    // Events collection
    match /events/{document=**} {
      allow read: if true; // Public read access
      allow write: if isAdmin(); // Only admins can modify
    }
    
    // Users collection (if you add user profiles later)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Notifications collection (if you add notifications)
    match /notifications/{userId}/{notification=**} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
